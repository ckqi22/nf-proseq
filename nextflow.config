nextflow.enable.dsl = 2
resume = true
trace.enabled = true
conda.enabled = true

docker {
    enabled = true
    runOptions = [
        '-u $(id -u):$(id -g)',
        '-v /workplace/database:/workplace/database:ro',
        '-v /workplace/pipeline:/workplace/pipeline:ro',
        '-v /workplace/hanguojun:/workplace/hanguojun'
    ].join(' ')
}

env {
    NF_SCRIPTS = "${projectDir}/bin"
}

profiles {
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}

process {
    container = 'nf-proseq:1.0.0'

    withName: 'EDGER' { container = null }
    withName: 'PCA_PLOT' { container = null }
    withName: 'GOKEGG' { container = null }
    withName: 'GSEA' { container = null }
}

workflow {
    output {
        mode = "copy"
    }
}

params {
    // ------------------------ resources ------------------------
    species_config = "/workplace/database/database_species_taxid_config.txt"
    information_config = "/workplace/database/database_information_config.txt"
    report_resources_dir = "/workplace/pipeline/resources"
    report_config = "params.yml"

    // ------------------------- 软件路径（容器内 PATH 直接调用）------------------------
    // bowtie2 = "/workplace/software/bowtie2-2.3.5.1-linux-x86_64/bowtie2"  // 裸调用，未用该参数
    feature_counts = "featureCounts"
    r              = "Rscript"
    python         = "python3"
    // fastq_screen = "/workplace/software/fastq_screen_v0.13.0/fastq_screen"  // 无引用
    fastp          = "fastp"
}
