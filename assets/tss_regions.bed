# TSS regions for PRO-seq pausing index: TSS -50bp to +300bp (350bp window)
# Generated from RefSeq gene annotations using:
#   For each gene: TSS-50 to TSS+300 (350bp window centered on the TSS +125bp offset)
#   Plus-strand genes: TSS = gene start
#   Minus-strand genes: TSS = gene end
# Columns: chr, start, end, gene_id, score, strand
#
# This file should be regenerated for each reference genome/annotation version.
# Example generation command (using bedtools and a RefSeq GTF):
#   awk -F'\t' -v OFS='\t' '$3=="transcript"' refseq.gtf | \
#     awk -v OFS='\t' '{
#       if($7=="+") {tss=$4; print $1, tss-50, tss+300, $9, ".", $7}
#       else        {tss=$5; print $1, tss-300, tss+50, $9, ".", $7}
#     }' | sort -k1,1 -k2,2n | uniq > tss_regions.bed
#
# Note: The gene_id should be extracted from the GTF attributes column ($9).
# Duplicate TSS regions (multiple transcripts per gene) should be collapsed
# or the most-used (longest) isoform chosen.
