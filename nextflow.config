nextflow.enable.dsl = 2
resume = true
trace.enabled = true
conda.enabled = true

docker {
    enabled = true
    runOptions = [
        '-u $(id -u):$(id -g)',
        '-v /workplace/database:/workplace/database:ro',
        '-v /workplace/pipeline:/workplace/pipeline:ro',
        '-v /workplace/hanguojun:/workplace/hanguojun'
    ].join(' ')
}

env {
    NF_SCRIPTS = "${projectDir}/bin"
}

workflow {
    output {
        mode = "copy"
    }
}

params {
    // ------------------------ resources ------------------------
    species_config = "/workplace/database/database_species_taxid_config.txt"
    information_config = "/workplace/database/database_information_config.txt"
    report_resources_dir = "/workplace/pipeline/resources"
    report_config = "params.yml"

    // ------------------------- 软件路径（容器内 PATH 直接调用）------------------------
    // bowtie2 = "/workplace/software/bowtie2-2.3.5.1-linux-x86_64/bowtie2"  // 裸调用，未用该参数
    feature_counts = "featureCounts"
    r              = "Rscript"
    python         = "python3"
    // fastq_screen = "/workplace/software/fastq_screen_v0.13.0/fastq_screen"  // 无引用
    fastp          = "fastp"
}

process {
    container = 'nf-proseq:1.0.0'

    withName: 'DESEQ2' { container = null }
    withName: 'EDGER' { container = null }
    withName: 'PCA_PLOT' { container = null }
    withName: 'GOKEGG' { container = null }
    withName: 'GSEA' { container = null }

    // ------------------------- 进程资源（逐进程配置）-------------------------
    // 默认值：未单独列出的进程
    cpus   = 1
    memory = 4.GB
    time   = 1.h

    // 选择器 '(.*:)?NAME' 同时匹配顶层调用与子工作流限定名(subworkflow:NAME), 别名进程(FASTQC_RAW 等)用正则覆盖。

    // ---- prepare_genome ----
    withName: '(.*:)?parse_config'     { cpus = 1; memory = 4.GB;  time = 1.h }   // python 读配置
    withName: '(.*:)?GTF2BED'          { cpus = 2; memory = 16.GB; time = 4.h }   // rtracklayer 读全 GTF
    withName: '(.*:)?GTF2SAF'          { cpus = 1; memory = 8.GB;  time = 2.h }
    withName: '(.*:)?BOWTIE2_BUILD'    { cpus = 8; memory = 32.GB; time = 24.h }  // 人基因组索引一次性构建
    withName: '(.*:)?SPIKEIN_CONCAT'   { cpus = 1; memory = 4.GB;  time = 1.h }

    // ---- preprocess ----
    withName: '(.*:)?FASTQC_(RAW|TRIMMED)' { cpus = 4; memory = 8.GB;  time = 4.h }  // fastqc --threads
    withName: '(.*:)?FASTP'            { cpus = 8; memory = 16.GB; time = 6.h }   // fastp --thread
    withName: '(.*:)?PROCESS_FASTP'    { cpus = 1; memory = 4.GB;  time = 1.h }
    withName: '(.*:)?REMOVE_RRNA'      { cpus = 16; memory = 16.GB; time = 8.h }  // bowtie2 vs rRNA 小索引

    // ---- align_bowtie2 ----
    withName: '(.*:)?BOWTIE2_ALIGN'    { cpus = 16; memory = 48.GB; time = 24.h } // bowtie2 + samtools sort（768M/线程）
    withName: '(.*:)?EXTRACT_R1'       { cpus = 4; memory = 8.GB;  time = 6.h }   // samtools view 流式
    withName: '(.*:)?STAT'             { cpus = 2; memory = 4.GB;  time = 2.h }

    // ---- spikein ----
    withName: '(.*:)?SPIKEIN_COUNT'    { cpus = 2; memory = 4.GB;  time = 2.h }
    withName: '(.*:)?SPIKEIN_SCALE'    { cpus = 1; memory = 4.GB;  time = 1.h }

    // ---- quantification / 标准化 ----
    withName: '(.*:)?FEATURECOUNTS'    { cpus = 8; memory = 16.GB; time = 8.h }   // featureCounts -T
    withName: '(.*:)?FEATURECOUNTS_MERGE' { cpus = 1; memory = 8.GB; time = 2.h }
    withName: '(.*:)?NORMALIZE'        { cpus = 1; memory = 8.GB;  time = 2.h }
    withName: '(.*:)?ANNOTATE'         { cpus = 1; memory = 8.GB;  time = 2.h }

    // ---- diff / enrich（container=null，走宿主机）----
    withName: '(.*:)?DESEQ2'           { cpus = 4; memory = 32.GB; time = 8.h }
    withName: '(.*:)?EDGER'            { cpus = 4; memory = 16.GB; time = 6.h }
    withName: '(.*:)?CHECKDE'          { cpus = 1; memory = 4.GB;  time = 1.h }
    withName: '(.*:)?DE_PLOT'          { cpus = 2; memory = 8.GB;  time = 2.h }
    withName: '(.*:)?PCA_PLOT'         { cpus = 2; memory = 8.GB;  time = 2.h }
    withName: '(.*:)?GOKEGG'           { cpus = 4; memory = 16.GB; time = 6.h }
    withName: '(.*:)?GSEA'             { cpus = 4; memory = 16.GB; time = 6.h }

    // ---- pol2_count（单碱基信号）----
    withName: '(.*:)?GENOMECOV(_FULL)?' { cpus = 4; memory = 16.GB; time = 6.h }  // bedtools genomecov + 全基因组 sort
    withName: '(.*:)?SINGLEBASE_COUNT_(PROMOTER|GENEBODY)' { cpus = 2; memory = 8.GB; time = 6.h } // bigWigAverageOverBed，10 万+ 区域/样本
    withName: '(.*:)?MERGE_(PROMOTER|GENEBODY)' { cpus = 1; memory = 8.GB; time = 2.h }

    // ---- pause_analysis ----
    withName: '(.*:)?pausing_index'    { cpus = 1; memory = 4.GB;  time = 1.h }
    withName: '(.*:)?pausing_boxplot'  { cpus = 1; memory = 4.GB;  time = 1.h }

    // ---- 信号表（位点 universe 数百万行；局部峰检测 O(G²)，修复前给足时长）----
    withName: '(.*:)?SIGNAL_TABLE'     { cpus = 4; memory = 48.GB; time = 24.h }

    // ---- metagene / deeptools ----
    withName: '(.*:)?BAMCOVERAGE'      { cpus = 8; memory = 32.GB; time = 12.h }  // --numberOfProcessors
    withName: '(.*:)?BIGWIGAVERAGE'    { cpus = 2; memory = 16.GB; time = 6.h }   // bigWigMerge + 全基因组 sort
    withName: '(.*:)?COMPUTEMATRIX_(PROFILE|HEATMAP|COMBINED)' { cpus = 8; memory = 32.GB; time = 12.h } // 9.27 后 10 万+ 转录本 TSS
    withName: '(.*:)?PLOTPROFILE(_COMBINED)?' { cpus = 2; memory = 8.GB; time = 2.h }
    withName: '(.*:)?PLOTHEATMAP'      { cpus = 2; memory = 8.GB;  time = 2.h }

    // ---- report ----
    withName: '(.*:)?FASTQC_IMAGES'    { cpus = 1; memory = 4.GB;  time = 1.h }
    withName: '(.*:)?OVERALL_STAT'     { cpus = 1; memory = 4.GB;  time = 1.h }
    withName: '(.*:)?TXT2XLSX'         { cpus = 2; memory = 8.GB;  time = 2.h }
    withName: '(.*:)?PAUSING_XLSX'     { cpus = 1; memory = 4.GB;  time = 1.h }
    withName: '(.*:)?POL2_SIGNAL_XLSX' { cpus = 2; memory = 8.GB;  time = 2.h }
    withName: '(.*:)?REPORT'           { cpus = 2; memory = 8.GB;  time = 2.h }
}

profiles {
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}
