nextflow.enable.dsl = 2
resume = true
trace.enabled = true

docker {
    enabled = true
    // Run as the invoking user, not the image's default 'ck' (uid 1000).
    // Otherwise the container can't write to the work directory (owned by
    // the host user, e.g. yunxu uid 1003) -> "touch .command.trace: Permission denied".
    runOptions = '-u $(id -u):$(id -g)'
}

env {
    NF_SCRIPTS = "${projectDir}/bin"
}

profiles {
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}

workflow {
    output {
        mode = "copy"
    }
}

params {
    // ------------------------ resources ------------------------
    species_config = "/workplace/database/database_species_taxid_config.txt"
    information_config = "/workplace/database/database_information_config.txt"

    // ------------------------- 软件路径 -------------------------
    feature_counts = "/workplace/pipeline/software/featureCounts"
    r = "/workplace/shuixin/R/4.4.1/bin/Rscript"
    fastq_screen = "/workplace/software/fastq_screen_v0.13.0/fastq_screen"
}
