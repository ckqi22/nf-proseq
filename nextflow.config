nextflow.enable.dsl = 2
resume = true
trace.enabled = true

env {
    NF_SCRIPTS = "${projectDir}/bin"
}

profiles {
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}

workflow {
    output {
        mode = "copy"
    }
}

params {
    // ------------------------ resources ------------------------
    species_config = "/workplace/database/database_species_taxid_config.txt"
    information_config = "/workplace/database/database_information_config.txt"

    // ------------------------- 软件路径 -------------------------
    feature_counts = "/workplace/pipeline/software/featureCounts"
    r = "/workplace/shuixin/R/4.4.1/bin/Rscript"
    fastq_screen = "/workplace/software/fastq_screen_v0.13.0/fastq_screen"

    // ------------------------- 输入参数 -------------------------
    adapter = "I"                              // Adapter 类型: I (Illumina), UMI, HT, SP
    sample_sheet = "${projectDir}/samplesheet.csv"
    outdir = "results"                         // 输出根目录

    // ------------------------- PRO-seq 特有参数 -------------------------
    // TSS 暂停指数参数
    tss_upstream = 50          // TSS 上游窗口（bp）
    tss_downstream = 300       // TSS 下游窗口（bp）
    gene_body_offset = 301     // 基因体起始偏移（bp，TSS+301bp 起）
    min_gene_length = 800      // 最小基因长度（bp），短于此值不计算 PI

    // Metagene 工具选择
    metagene_tool = "deepTools"  // deepTools 或 ngsplot
    tss_metagene_window = 3000   // TSS Metagene 窗口（bp）
    tes_metagene_window = 3000   // TES Metagene 窗口（bp）

    // 差异分析
    diff_tool = "edgeR"          // edgeR（也可选 DESeq2）
    diff_fc_cutoff = 1.5         // 默认 Fold Change 阈值
    diff_pval_cutoff = 0.05      // 默认 P-value 阈值

    // BigWig 参数
    effective_genome_size = 2913022398  // hg38 effective genome size for RPGC normalization

    // UMI 参数
    umi_length = 7              // UMI 长度（仅 adapter=UMI 时生效）
}
