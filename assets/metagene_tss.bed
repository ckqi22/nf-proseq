# TSS regions for metagene analysis: TSS +/- 3000bp
# Generated from RefSeq gene annotations using:
#   For each gene, extract a 6001bp window centered on the TSS:
#     Plus-strand genes:  TSS - 3000 to TSS + 3000
#     Minus-strand genes: TSS - 3000 to TSS + 3000 (TSS = gene end for minus strand)
# Columns: chr, start, end, gene_id, score, strand
#
# This file should be regenerated for each reference genome/annotation version.
# Example generation command (using bedtools and a RefSeq GTF):
#   awk -F'\t' -v OFS='\t' '$3=="transcript"' refseq.gtf | \
#     awk -v OFS='\t' '{
#       if($7=="+") {tss=$4; print $1, tss-3000, tss+3000, $9, ".", $7}
#       else        {tss=$5; print $1, tss-3000, tss+3000, $9, ".", $7}
#     }' | sort -k1,1 -k2,2n | uniq > metagene_tss.bed
#
# Note: Ensure start >= 0 (clamp to 0 for negative starts at chromosome edges).
# Duplicate TSS regions (multiple transcripts per gene) should be collapsed
# or the most-used (longest) isoform chosen.
# Used by: metagene_matrix.R with computeMatrix reference-point --referencePoint TSS
